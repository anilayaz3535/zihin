{"id": "C2-1:45", "en": "Only once did the author visit Istanbul.", "p": [["T", "Only once", "yalnızca bir kez"], ["V", "did", "(devrik yapı)"], ["S", "the author", "yazar"], ["V", "visit", "ziyaret etti"], ["O", "Istanbul", "İstanbul'u"]]}
