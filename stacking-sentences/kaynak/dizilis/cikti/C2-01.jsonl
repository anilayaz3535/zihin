{"id": "C2-1:55", "en": "Not for a moment did I doubt her talent.", "p": [["T", "Not for a moment", "bir an bile"], ["V", "did", "(devrik yapı)"], ["S", "I", "ben"], ["V", "doubt", "şüphe etmedim"], ["O", "her talent", "onun yeteneğinden"]]}
