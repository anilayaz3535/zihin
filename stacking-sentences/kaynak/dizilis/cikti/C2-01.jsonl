{"id": "C2-1:57", "en": "All that remains is a fragment of the poem.", "p": [["S", "All that remains", "geriye kalan tek şey"], ["V", "is", "(ek fiil)"], ["O", "a fragment of the poem", "şiirin bir parçası"]]}
{"id": "C2-1:58", "en": "Seldom had the scientists encountered such resistance.", "p": [["T", "Seldom", "nadiren"], ["V", "had", "(devrik yapı)"], ["S", "the scientists", "bilim insanları"], ["V", "encountered", "karşılaşmıştı"], ["O", "such resistance", "böyle bir dirençle"]]}
{"id": "C2-1:59", "en": "It was the printing press that spread literacy.", "p": [["S", "It", "—"], ["V", "was the printing press", "matbaaydı"], ["BAG", "that", "(-an)"], ["V", "spread", "yayan"], ["O", "literacy", "okuryazarlığı"]]}
