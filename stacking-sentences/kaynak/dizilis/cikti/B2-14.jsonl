{"id": "B2-35:11", "en": "Is the proposed schedule feasible?", "p": [["SORU", "Is", "(soru)"], ["S", "the proposed schedule", "önerilen takvim"], ["V", "feasible", "uygulanabilir mi"]]}
{"id": "B2-35:12", "en": "They were reluctant to accept the offer.", "p": [["S", "They", "onlar"], ["V", "were reluctant", "isteksizdiler"], ["O", "to accept the offer", "teklifi kabul etmeye"]]}
