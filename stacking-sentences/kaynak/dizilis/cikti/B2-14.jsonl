{"id": "B2-35:25", "en": "I had my laptop repaired.", "p": [["S", "I", "ben"], ["V", "had", "(had … repaired)"], ["O", "my laptop", "dizüstü bilgisayarımı"], ["V", "repaired", "tamir ettirdim"]]}
