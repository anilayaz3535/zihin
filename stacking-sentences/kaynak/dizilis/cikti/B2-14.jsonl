{"id": "B2-35:27", "en": "She is used to working at night.", "p": [["S", "She", "o"], ["V", "is used to", "alışkındır"], ["O", "working at night", "gece çalışmaya"]]}
{"id": "B2-35:28", "en": "Neither of the proposals is acceptable to me.", "p": [["S", "Neither of the proposals", "önerilerin hiçbiri"], ["V", "is acceptable", "kabul edilebilir değil"], ["EK", "to me", "benim için"]]}
