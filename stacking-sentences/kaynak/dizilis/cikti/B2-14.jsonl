{"id": "B2-35:19", "en": "These changes may pose a threat to wildlife.", "p": [["S", "These changes", "bu değişiklikler"], ["V", "may pose", "oluşturabilir"], ["O", "a threat", "bir tehdit"], ["EK", "to wildlife", "yaban hayatı için"]]}
{"id": "B2-35:20", "en": "If I had more time, I would learn Japanese.", "p": [["BAG", "If", "-sa"], ["S", "I", "benim"], ["V", "had", "olsa"], ["O", "more time", "daha fazla zamanım"], ["S", "I", "ben"], ["V", "would learn", "öğrenirdim"], ["O", "Japanese", "Japonca"]]}
