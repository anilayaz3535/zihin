{"id": "C1-10:42", "en": "The lost child was in distress until his mother turned up.", "p": [["S", "The lost child", "kaybolan çocuk"], ["V", "was in distress", "büyük bir sıkıntı içindeydi"], ["BAG", "until", "-ene kadar"], ["S", "his mother", "annesi"], ["V", "turned up", "gelene kadar"]]}
