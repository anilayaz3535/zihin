{"id": "B1-32:7", "en": "She wanted to raise a concern about the schedule.", "p": [["S", "She", "o"], ["V", "wanted to raise", "dile getirmek istedi"], ["O", "a concern", "bir kaygısını"], ["EK", "about the schedule", "programla ilgili"]]}
{"id": "B1-32:8", "en": "Let us keep in touch after the course.", "p": [["KALIP", "Let us", "haydi"], ["V", "keep in touch", "iletişimde kalalım"], ["T", "after the course", "kurstan sonra"]]}
{"id": "B1-32:9", "en": "It is difficult to keep in touch when everyone is busy.", "p": [["S", "It", "—"], ["V", "is difficult", "zordur"], ["S", "to keep in touch", "iletişimde kalmak"], ["BAG", "when", "-ken"], ["S", "everyone", "herkes"], ["V", "is busy", "meşgulken"]]}
{"id": "B1-32:10", "en": "You can change your mind before signing.", "p": [["S", "You", "sen"], ["V", "can change", "değiştirebilirsin"], ["O", "your mind", "fikrini"], ["T", "before signing", "imzalamadan önce"]]}
{"id": "B1-32:11", "en": "What would make you change your mind?", "p": [["SORU", "What", "ne"], ["V", "would make", "sağlardı"], ["O", "you", "senin"], ["V", "change", "değiştirmeni"], ["O", "your mind", "fikrini"]]}
{"id": "B1-32:12", "en": "He did not break the glass on purpose.", "p": [["S", "He", "o"], ["V", "did not break", "kırmadı"], ["O", "the glass", "bardağı"], ["NASIL", "on purpose", "bilerek"]]}
{"id": "B1-32:13", "en": "Did she leave the door open on purpose?", "p": [["SORU", "Did", "(soru)"], ["S", "she", "o"], ["V", "leave", "bıraktı"], ["O", "the door", "kapıyı"], ["EK", "open", "açık"], ["NASIL", "on purpose", "bilerek mi"]]}
{"id": "B1-32:14", "en": "I deleted the message by accident.", "p": [["S", "I", "ben"], ["V", "deleted", "sildim"], ["O", "the message", "mesajı"], ["NASIL", "by accident", "kazara"]]}
{"id": "B1-32:15", "en": "She took my bag by accident.", "p": [["S", "She", "o"], ["V", "took", "aldı"], ["O", "my bag", "çantamı"], ["NASIL", "by accident", "kazara"]]}
{"id": "B1-32:16", "en": "We need to come up with an idea before lunch.", "p": [["S", "We", "bizim"], ["V", "need to come up with", "bulmamız gerekiyor"], ["O", "an idea", "bir fikir"], ["T", "before lunch", "öğle yemeğinden önce"]]}
{"id": "B1-32:17", "en": "How did you come up with an idea so quickly?", "p": [["SORU", "How", "nasıl"], ["SORU", "did", "(soru)"], ["S", "you", "sen"], ["V", "come up with", "buldun"], ["O", "an idea", "bir fikir"], ["NASIL", "so quickly", "bu kadar çabuk"]]}
{"id": "B1-32:18", "en": "We should not put off a decision forever.", "p": [["S", "We", "biz"], ["V", "should not put off", "ertelememeliyiz"], ["O", "a decision", "bir kararı"], ["T", "forever", "sonsuza kadar"]]}
{"id": "B1-32:19", "en": "It can be wise to put off a decision until you have the facts.", "p": [["S", "It", "—"], ["V", "can be wise", "akıllıca olabilir"], ["S", "to put off a decision", "bir kararı ertelemek"], ["BAG", "until", "-ene kadar"], ["S", "you", "sen"], ["V", "have", "öğrenene kadar"], ["O", "the facts", "gerçekleri"]]}
{"id": "B1-32:20", "en": "Do you get along with your neighbours?", "p": [["SORU", "Do", "(soru)"], ["S", "you", "sen"], ["V", "get along", "iyi geçinir misin"], ["EK", "with your neighbours", "komşularınla"]]}
{"id": "B1-32:21", "en": "I get along with everyone in my team.", "p": [["S", "I", "ben"], ["V", "get along", "iyi geçinirim"], ["EK", "with everyone", "herkesle"], ["P", "in my team", "ekibimdeki"]]}
{"id": "B1-32:22", "en": "Would you like to take part in the discussion?", "p": [["SORU", "Would", "(soru)"], ["S", "you", "sen"], ["V", "like to take part", "katılmak ister misin"], ["O", "in the discussion", "tartışmaya"]]}
{"id": "B1-32:23", "en": "Students can take part in the project.", "p": [["S", "Students", "öğrenciler"], ["V", "can take part", "katılabilir"], ["O", "in the project", "projeye"]]}
{"id": "B1-32:24", "en": "We need a reliable source of information.", "p": [["S", "We", "bizim"], ["V", "need", "ihtiyacımız var"], ["O", "a reliable source of information", "bir güvenilir bilgi kaynağına"]]}
{"id": "B1-32:25", "en": "You can achieve your goals with practice.", "p": [["S", "You", "sen"], ["V", "can achieve", "ulaşabilirsin"], ["O", "your goals", "hedeflerine"], ["NASIL", "with practice", "pratik yaparak"]]}
{"id": "B1-32:26", "en": "She works as a volunteer at weekends.", "p": [["S", "She", "o"], ["V", "works", "çalışır"], ["EK", "as a volunteer", "gönüllü olarak"], ["T", "at weekends", "hafta sonları"]]}
{"id": "B1-32:27", "en": "Every decision has a consequence.", "p": [["S", "Every decision", "her kararın"], ["V", "has", "vardır"], ["O", "a consequence", "bir sonucu"]]}
{"id": "B1-32:28", "en": "Taking care of the garden is my responsibility.", "p": [["S", "Taking care of the garden", "bahçeye bakmak"], ["V", "is my responsibility", "benim sorumluluğumdur"]]}
{"id": "B1-32:29", "en": "Teachers encourage students to ask questions.", "p": [["S", "Teachers", "öğretmenler"], ["V", "encourage", "teşvik eder"], ["O", "students", "öğrencileri"], ["EK", "to ask questions", "soru sormaya"]]}
{"id": "B1-32:30", "en": "Although it was raining, we went outside.", "p": [["BAG", "Although", "-masına rağmen"], ["S", "it", "—"], ["V", "was raining", "yağmur yağmasına rağmen"], ["S", "we", "biz"], ["V", "went", "çıktık"], ["P", "outside", "dışarı"]]}
{"id": "B1-32:31", "en": "You will miss the bus unless you hurry.", "p": [["S", "You", "sen"], ["V", "will miss", "kaçıracaksın"], ["O", "the bus", "otobüsü"], ["BAG", "unless", "-mazsan"], ["S", "you", "sen"], ["V", "hurry", "acele etmezsen"]]}
