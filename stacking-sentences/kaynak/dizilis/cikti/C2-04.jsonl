{"id": "C2-19:21", "en": "The project benefited in no small measure from local knowledge.", "p": [["S", "The project", "proje"], ["V", "benefited", "yararlandı"], ["KALIP", "in no small measure", "azımsanmayacak ölçüde"], ["EK", "from local knowledge", "yerel bilgiden"]]}
{"id": "C2-19:22", "en": "Repeating the same failed approach is an exercise in futility.", "p": [["S", "Repeating the same failed approach", "aynı başarısız yaklaşımı tekrarlamak"], ["V", "is", "(ek fiil)"], ["KALIP", "an exercise in futility", "sonuçsuz bir çabadır"]]}
