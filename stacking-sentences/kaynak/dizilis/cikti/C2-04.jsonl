{"id": "C2-19:12", "en": "Notwithstanding the foregoing, either party may end the agreement.", "p": [["KALIP", "Notwithstanding the foregoing", "yukarıda belirtilenlere rağmen"], ["S", "either party", "taraflardan her biri"], ["V", "may end", "sona erdirebilir"], ["O", "the agreement", "anlaşmayı"]]}
{"id": "C2-19:13", "en": "Notwithstanding the foregoing, the safety requirements still apply.", "p": [["KALIP", "Notwithstanding the foregoing", "yukarıda belirtilenlere rağmen"], ["S", "the safety requirements", "güvenlik koşulları"], ["T", "still", "hâlâ"], ["V", "apply", "geçerlidir"]]}
{"id": "C2-19:14", "en": "The burden of proof lies with the person making the claim.", "p": [["S", "The burden of proof", "ispat yükü"], ["V", "lies", "aittir"], ["EK", "with the person", "kişiye"], ["V", "making", "öne süren"], ["O", "the claim", "iddiayı"]]}
{"id": "C2-19:15", "en": "This argument does not remove the burden of proof.", "p": [["S", "This argument", "bu argüman"], ["V", "does not remove", "ortadan kaldırmaz"], ["O", "the burden of proof", "ispat yükünü"]]}
{"id": "C2-19:16", "en": "The crux of the matter is whether the evidence is reliable.", "p": [["S", "The crux of the matter", "meselenin özü"], ["V", "is", "(ek fiil)"], ["BAG", "whether", "-ıp -madığıdır"], ["S", "the evidence", "kanıtın"], ["V", "is reliable", "güvenilir olup olmadığıdır"]]}
{"id": "C2-19:17", "en": "We have yet to address the crux of the matter.", "p": [["S", "We", "biz"], ["V", "have yet to address", "henüz ele almadık"], ["O", "the crux of the matter", "meselenin özünü"]]}
