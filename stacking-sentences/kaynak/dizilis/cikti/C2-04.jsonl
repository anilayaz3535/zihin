{"id": "C2-19:24", "en": "Equifinality means that different paths can lead to the same outcome.", "p": [["S", "Equifinality", "eşsonluluk"], ["V", "means", "demektir"], ["BAG", "that", "-ması"], ["S", "different paths", "farklı yolların"], ["V", "can lead", "ulaşabilmesi"], ["EK", "to the same outcome", "aynı sonuca"]]}
{"id": "C2-19:25", "en": "The model accounts for equifinality in complex systems.", "p": [["S", "The model", "model"], ["V", "accounts for", "hesaba katar"], ["O", "equifinality", "eşsonluluğu"], ["P", "in complex systems", "karmaşık sistemlerde"]]}
{"id": "C2-19:26", "en": "Path-dependence explains why earlier choices constrain later options.", "p": [["S", "Path-dependence", "izlenen yola bağımlılık"], ["V", "explains", "açıklar"], ["SORU", "why", "neden"], ["S", "earlier choices", "önceki seçimlerin"], ["V", "constrain", "sınırladığını"], ["O", "later options", "sonraki seçenekleri"]]}
{"id": "C2-19:27", "en": "The analysis highlights path-dependence in institutional change.", "p": [["S", "The analysis", "analiz"], ["V", "highlights", "vurguluyor"], ["O", "path-dependence", "izlenen yola bağımlılığı"], ["EK", "in institutional change", "kurumsal değişimde"]]}
{"id": "C2-19:28", "en": "A counterfactual scenario asks what might have happened otherwise.", "p": [["S", "A counterfactual scenario", "gerçekleşmemiş alternatif bir senaryo"], ["V", "asks", "sorar"], ["SORU", "what", "neler"], ["V", "might have happened", "olabileceğini"], ["EK", "otherwise", "başka koşullarda"]]}
