{"id": "A1-20:3", "en": "Do you brush your teeth after breakfast?", "p": [["SORU", "Do", "(soru)"], ["S", "you", "sen"], ["V", "brush", "fırçalar mısın"], ["O", "your teeth", "dişlerini"], ["T", "after breakfast", "kahvaltıdan sonra"]]}
{"id": "A1-20:4", "en": "I make the bed every morning.", "p": [["S", "I", "ben"], ["V", "make", "toplarım"], ["O", "the bed", "yatağı"], ["T", "every morning", "her sabah"]]}
{"id": "A1-20:5", "en": "Can you make the bed, please?", "p": [["SORU", "Can", "(soru)"], ["S", "you", "sen"], ["V", "make", "toplar mısın"], ["O", "the bed", "yatağı"], ["KALIP", "please", "lütfen"]]}
{"id": "A1-20:6", "en": "I take a shower after work.", "p": [["S", "I", "ben"], ["V", "take", "alırım"], ["O", "a shower", "bir duş"], ["T", "after work", "işten sonra"]]}
{"id": "A1-20:7", "en": "She wants to take a shower.", "p": [["S", "She", "o"], ["V", "wants to take", "almak istiyor"], ["O", "a shower", "bir duş"]]}
