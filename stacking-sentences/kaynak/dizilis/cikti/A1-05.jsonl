{"id": "A1-20:21", "en": "Where do we get off the bus?", "p": [["SORU", "Where", "nerede"], ["SORU", "do", "(soru)"], ["S", "we", "biz"], ["V", "get off", "iniyoruz"], ["O", "the bus", "otobüsten"]]}
