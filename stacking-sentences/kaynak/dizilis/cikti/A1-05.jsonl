{"id": "A1-19:18", "en": "We clean the kitchen on Sundays.", "p": [["S", "We", "biz"], ["V", "clean", "temizleriz"], ["O", "the kitchen", "mutfağı"], ["T", "on Sundays", "pazar günleri"]]}
{"id": "A1-19:19", "en": "Please wait near the door.", "p": [["KALIP", "Please", "lütfen"], ["V", "wait", "bekle"], ["P", "near the door", "kapının yanında"]]}
{"id": "A1-19:20", "en": "My father is busy today.", "p": [["S", "My father", "babam"], ["V", "is busy", "meşgul"], ["T", "today", "bugün"]]}
{"id": "A1-19:21", "en": "This room is quiet.", "p": [["S", "This room", "bu oda"], ["V", "is quiet", "sessiz"]]}
{"id": "A1-19:22", "en": "The glass is empty.", "p": [["S", "The glass", "bardak"], ["V", "is empty", "boş"]]}
{"id": "A1-19:23", "en": "The bus is full.", "p": [["S", "The bus", "otobüs"], ["V", "is full", "dolu"]]}
{"id": "A1-19:24", "en": "Are you hungry now?", "p": [["SORU", "Are", "(soru)"], ["S", "you", "sen"], ["V", "hungry", "aç mısın"], ["T", "now", "şimdi"]]}
{"id": "A1-19:25", "en": "I am thirsty after my walk.", "p": [["S", "I", "ben"], ["V", "am thirsty", "susadım"], ["T", "after my walk", "yürüyüşümden sonra"]]}
