{"id": "A1-20:17", "en": "Can you pay in cash today?", "p": [["SORU", "Can", "(soru)"], ["S", "you", "sen"], ["V", "pay", "ödeyebilir misin"], ["NASIL", "in cash", "nakit"], ["T", "today", "bugün"]]}
{"id": "A1-20:18", "en": "We get on the bus near school.", "p": [["S", "We", "biz"], ["V", "get on", "bineriz"], ["O", "the bus", "otobüse"], ["P", "near school", "okulun yakınında"]]}
