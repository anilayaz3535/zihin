{"id": "A1-20:0", "en": "I get dressed after breakfast.", "p": [["S", "I", "ben"], ["V", "get dressed", "giyinirim"], ["T", "after breakfast", "kahvaltıdan sonra"]]}
{"id": "A1-20:1", "en": "Please get dressed before we leave.", "p": [["KALIP", "Please", "lütfen"], ["V", "get dressed", "giyin"], ["BAG", "before", "önce"], ["S", "we", "biz"], ["V", "leave", "çıkmadan"]]}
