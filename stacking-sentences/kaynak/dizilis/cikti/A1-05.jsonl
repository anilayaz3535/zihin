{"id": "A1-19:0", "en": "I am ready for the lesson.", "p": [["S", "I", "ben"], ["V", "am ready", "hazırım"], ["EK", "for the lesson", "ders için"]]}
{"id": "A1-19:1", "en": "Her brother has a green bicycle.", "p": [["S", "Her brother", "onun erkek kardeşinin"], ["V", "has", "var"], ["O", "a green bicycle", "bir yeşil bisikleti"]]}
{"id": "A1-19:2", "en": "Where do your parents work?", "p": [["SORU", "Where", "nerede"], ["SORU", "do", "(soru)"], ["S", "your parents", "anne baban"], ["V", "work", "çalışıyor"]]}
{"id": "A1-19:3", "en": "We usually eat dinner at seven.", "p": [["S", "We", "biz"], ["V", "usually eat", "genellikle yeriz"], ["O", "dinner", "akşam yemeği"], ["T", "at seven", "saat yedide"]]}
{"id": "A1-19:4", "en": "There are three cups on the table.", "p": [["V", "There are", "var"], ["S", "three cups", "üç fincan"], ["P", "on the table", "masanın üstünde"]]}
{"id": "A1-19:5", "en": "I need some water.", "p": [["S", "I", "benim"], ["V", "need", "ihtiyacım var"], ["O", "some water", "biraz suya"]]}
{"id": "A1-19:6", "en": "He does not drink coffee.", "p": [["S", "He", "o"], ["V", "does not drink", "içmez"], ["O", "coffee", "kahve"]]}
{"id": "A1-19:7", "en": "The children are drawing a picture.", "p": [["S", "The children", "çocuklar"], ["V", "are drawing", "çiziyor"], ["O", "a picture", "bir resim"]]}
{"id": "A1-19:8", "en": "Can your sister swim?", "p": [["SORU", "Can", "(soru)"], ["S", "your sister", "kız kardeşin"], ["V", "swim", "yüzebilir mi"]]}
{"id": "A1-19:9", "en": "The keys are under the chair.", "p": [["S", "The keys", "anahtarlar"], ["V", "are", "(ek fiil)"], ["P", "under the chair", "sandalyenin altında"]]}
{"id": "A1-19:10", "en": "She is an engineer.", "p": [["S", "She", "o"], ["V", "is an engineer", "bir mühendis"]]}
{"id": "A1-19:11", "en": "Please close the window.", "p": [["KALIP", "Please", "lütfen"], ["V", "close", "kapat"], ["O", "the window", "pencereyi"]]}
{"id": "A1-19:12", "en": "Please open the blue box.", "p": [["KALIP", "Please", "lütfen"], ["V", "open", "aç"], ["O", "the blue box", "mavi kutuyu"]]}
{"id": "A1-19:13", "en": "Close the door, please.", "p": [["V", "Close", "kapat"], ["O", "the door", "kapıyı"], ["KALIP", "please", "lütfen"]]}
{"id": "A1-19:14", "en": "I wash my hands before lunch.", "p": [["S", "I", "ben"], ["V", "wash", "yıkarım"], ["O", "my hands", "ellerimi"], ["T", "before lunch", "öğle yemeğinden önce"]]}
{"id": "A1-19:15", "en": "I wear a coat in winter.", "p": [["S", "I", "ben"], ["V", "wear", "giyerim"], ["O", "a coat", "bir palto"], ["T", "in winter", "kışın"]]}
