{"id": "A1-19:29", "en": "The children walk quickly.", "p": [["S", "The children", "çocuklar"], ["V", "walk", "yürür"], ["NASIL", "quickly", "hızlı"]]}
{"id": "A1-19:30", "en": "The bank is next to the school.", "p": [["S", "The bank", "banka"], ["V", "is", "(ek fiil)"], ["P", "next to the school", "okulun yanındadır"]]}
{"id": "A1-19:31", "en": "A car is in front of the house.", "p": [["S", "A car", "bir araba"], ["V", "is", "var"], ["P", "in front of the house", "evin önünde"]]}
{"id": "A1-19:32", "en": "I am ready.", "p": [["S", "I", "ben"], ["V", "am ready", "hazırım"]]}
{"id": "A1-19:33", "en": "She has a red bag.", "p": [["S", "She", "onun"], ["V", "has", "var"], ["O", "a red bag", "bir kırmızı çantası"]]}
{"id": "A1-19:34", "en": "He doesn't like tea.", "p": [["S", "He", "o"], ["V", "doesn't like", "sevmez"], ["O", "tea", "çayı"]]}
